<UserControl x:Class="VidLex.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="О программе" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/VidLex.png" Width="72" Height="72" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock FontSize="28" FontWeight="Bold">
                            <Run Text="Vid" /><Run Text="Lex" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Версия" /> <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Разработчик: Ходаковский Александр" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" MaxWidth="620"
                                   Text="VidLex находит видео в выбранной папке и всех вложенных каталогах, распознаёт русскую речь и сохраняет грамотно оформленный текст в TXT — рядом с видео или в отдельной папке." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Конфиденциальность" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Label}" Text="Вся обработка выполняется на этом компьютере. Видео, аудио и тексты никуда не отправляются; сеть VidLex не использует." />
                    <TextBlock Style="{StaticResource Hint}" Text="Содержимое расшифровок в журнал не записывается." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Компоненты и лицензии" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="• whisper.cpp (whisper-cli) — распознавание речи; MIT, авторы ggml. Модели Whisper — OpenAI, MIT." />
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="• FFmpeg — чтение видео и извлечение аудио; LGPL/GPL, устанавливается отдельно." />
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="• Словарь ru_RU для Hunspell — А. И. Лебедев; BSD." />
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="• WeCantSpell.Hunspell — проверка орфографии; MPL 1.1 / GPL 2.0 / LGPL 2.1." />
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="• Newtonsoft.Json — MIT; Ookii.Dialogs.Wpf — BSD-3-Clause." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Данные программы" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Label}">
                        <Run Text="Настройки, журналы, временные файлы и модели:" />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>
                    <Button Content="Открыть папку данных" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding OpenDataFolderCommand}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Горячие клавиши: Ctrl+1 — Главная, Ctrl+2 — Настройки, Ctrl+3 — Журнал, F1 — О программе. Alt + подчёркнутая буква — кнопки." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
