<Window x:Class="VidLex.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border x:Name="KindMark" Width="6" Height="22" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" />
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" LineHeight="20" />
        <StackPanel x:Name="DetailsPanel" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Подробности" Style="{StaticResource Hint}" Margin="0,0,0,6" />
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" />
            <Button Content="_Копировать подробности" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyDetails_Click" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="NoButton" IsCancel="True" Click="No_Click" />
            <Button x:Name="YesButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Yes_Click" />
        </StackPanel>
    </Grid>
</Window>
