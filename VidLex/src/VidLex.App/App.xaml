<Application x:Class="VidLex.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VidLex.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StatusToBrushConverter x:Key="StatusBrush" />
            <conv:LogLevelToBrushConverter x:Key="LevelBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <conv:StringToVisibilityConverter x:Key="StrToVis" />
            <conv:EnumEqualsConverter x:Key="EnumEq" />
            <conv:PercentConverter x:Key="Percent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
