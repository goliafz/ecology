<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>VidLex</AssemblyName>
    <RootNamespace>VidLex.App</RootNamespace>
    <ApplicationIcon>Resources\VidLex.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>VidLex — разработчик Ходаковский Александр</AssemblyTitle>
    <Description>VidLex: транскрибация русскоязычных видео в TXT. Разработчик: Ходаковский Александр.</Description>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VidLex.Core\VidLex.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\VidLex.png" />
    <Resource Include="Resources\VidLex.ico" />
    <None Update="Dictionaries\ru_RU.dic" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Dictionaries\ru_RU.aff" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Dictionaries\LICENSE-ru_RU.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
