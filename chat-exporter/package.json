{
  "name": "chat-exporter",
  "version": "1.3.2",
  "private": true,
  "description": "Chrome MV3 extension: export ChatGPT and Claude conversations to PDF/HTML/Markdown with scheduled backups",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "vendor": "node tools/vendor.mjs",
    "package": "node tools/package.mjs",
    "check": "npm run typecheck && npm test",
    "e2e": "node tests/e2e/extension.e2e.mjs",
    "e2e:pdf": "node tests/e2e/pdf-background.e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "jsdom": "^29.1.1",
    "marked": "^15.0.12",
    "typescript": "^7.0.2"
  },
  "author": "Ходаковский Александр"
}
