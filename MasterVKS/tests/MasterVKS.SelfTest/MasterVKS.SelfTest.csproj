<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Автотесты логики программы. Запускаются на любой ОС с .NET 8 и ffmpeg в PATH:
      dotnet run -c Release
    Проверяют синхронизацию, выравнивание часов устройств, анализ звука,
    команды FFmpeg, склейку частей и восстановление после сбоя.
    Части, которым нужен настоящий Windows (захват экрана, WASAPI), здесь не участвуют.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>MasterVks.SelfTest</RootNamespace>
    <NoWarn>CA1416;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MasterVKS\Core\*.cs" Link="App\Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\MasterVKS\Audio\*.cs" Link="App\Audio\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\MasterVKS\Video\*.cs" Link="App\Video\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\MasterVKS\Recording\*.cs" Link="App\Recording\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\MasterVKS\Checks\*.cs" Link="App\Checks\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
