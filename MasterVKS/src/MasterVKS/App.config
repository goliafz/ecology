<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Не даём сборщику мусора останавливать все потоки надолго во время записи -->
    <gcConcurrent enabled="true" />
  </runtime>
</configuration>
